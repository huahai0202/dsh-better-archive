{
  "name": "dsh-better-archive",
  "description": "Sidebar Archived entry + archived-session panel with unarchive and delete, for the DeepSeek Harness web GUI",
  "version": "0.6.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "ui",
    "archive",
    "unarchive",
    "session"
  ],
  "license": "MIT",
  "author": "huahai0202",
  "repository": {
    "type": "git",
    "url": "https://github.com/huahai0202/dsh-better-archive.git"
  },
  "homepage": "https://github.com/huahai0202/dsh-better-archive#readme",
  "bugs": {
    "url": "https://github.com/huahai0202/dsh-better-archive/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.5-alpha.1",
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
